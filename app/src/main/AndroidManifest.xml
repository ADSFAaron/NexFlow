<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Notifications (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Foreground service. specialUse (not dataSync): NexFlow runs a persistent automation
         engine; dataSync has a 6h/day cap on Android 15 that would silently kill automation. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Boot trigger -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Wi-Fi toggle + SSID detection -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <!-- Bluetooth toggle + device name (BLUETOOTH_SCAN needed on API 31+) -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        tools:ignore="ProtectedPermissions" />

    <!-- Screen brightness (WRITE_SETTINGS granted at runtime via special app access UI) -->
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- Do Not Disturb toggle -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- Airplane mode / advanced toggle (granted via ADB only) -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- NFC tag scanning -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />

    <!-- Geofence + WiFi SSID detection -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Background location required for geofence on Android 10+ -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- SMS (RECEIVE/SEND), READ_PHONE_STATE and CALL_PHONE are declared only in the
         `github` flavor (src/github/AndroidManifest.xml). The Play Store flavor ships
         without them because Google Play restricts SMS/Call permissions to default
         handler apps. -->

    <!-- Query all installed apps for AppPicker + APP_LAUNCH trigger -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name=".NexFlowApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NexFlow">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.NexFlow"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- NFC tag dispatch — receives NFC intents when app is in foreground -->
            <intent-filter>
                <action android:name="android.nfc.action.TAG_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Receive shared NexFlow JSON (from another device's Export button) -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/json" />
            </intent-filter>
            <!-- Open a saved .flow/.json file directly -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/json" />
            </intent-filter>
            <!-- App Shortcut: run a specific flow by ID -->
            <intent-filter>
                <action android:name="com.nexflow.action.RUN_FLOW" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Background execution engine -->
        <service
            android:name=".service.FlowExecutionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="task_automation" />
        </service>

        <!-- Auto-start after device boot -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Overview widget (4×2): shows recent flows with run buttons -->
        <receiver
            android:name=".widget.NexFlowWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/nexflow_widget_info" />
        </receiver>

        <!-- Single-flow shortcut widget (1×1): user picks a flow after placement -->
        <receiver
            android:name=".widget.NexFlowSingleWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/nexflow_widget_single_info" />
        </receiver>

        <!-- Wide single-flow shortcut widget (2×1): user picks a flow after placement -->
        <receiver
            android:name=".widget.NexFlowWideWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/nexflow_widget_wide_info" />
        </receiver>

        <!-- Widget configuration activity: lets users select a flow for single/wide widgets.
             taskAffinity="" isolates this activity in its own task so finishing it does not
             surface the main app's back-stack (prevents the "jumps to home screen" bug). -->
        <activity
            android:name=".widget.WidgetConfigureActivity"
            android:exported="true"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:theme="@style/Theme.NexFlow">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Accessibility Service for screenshot action -->
        <service
            android:name=".service.NexFlowAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/nexflow_accessibility_config" />
        </service>

        <!-- SmsReceiver and PhoneStateReceiver are declared only in the `github` flavor
             (src/github/AndroidManifest.xml). -->

        <!-- Geofence transition receiver (woken by Google Play Services) -->
        <receiver
            android:name=".receiver.GeofenceTransitionReceiver"
            android:exported="false" />

        <!-- Quick Settings Tile — user adds from QS edit panel -->
        <service
            android:name=".service.NexFlowTileService"
            android:exported="true"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Tile configuration activity: lets users pick which flow the QS tile runs.
             QS_TILE_PREFERENCES intent-filter makes Android 13+ show an "Edit" button
             on long-press. On older versions, the tile itself opens this activity when
             no flow is configured. taskAffinity="" prevents surfacing the main app task. -->
        <activity
            android:name=".service.TileConfigureActivity"
            android:exported="true"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:theme="@style/Theme.NexFlow">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity>

        <!-- Notification Listener Service — user enables in Settings → Notifications → Notification access -->
        <service
            android:name=".service.NexFlowNotificationListenerService"
            android:exported="true"
            android:label="NexFlow"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- FileProvider for exporting .flow files -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Transparent trampoline for the SHOW_MENU action bottom sheet.
             taskAffinity="" keeps it out of the main app back-stack.
             excludeFromRecents prevents the ghost task appearing in Recents. -->
        <activity
            android:name=".ui.menu.MenuPickerActivity"
            android:exported="false"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:theme="@style/Theme.NexFlow.Transparent" />

        <!-- WorkManager Hilt integration -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>

</manifest>
