<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- AppCompat.DayNight parent is required because MainActivity extends
         AppCompatActivity (for in-app per-app language switching). Compose still
         drives the real UI theme via NexFlowTheme; this only styles the window
         background / splash. -->
    <style name="Theme.NexFlow" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Android 12+ 的系統 splash 背景會 fallback 到 windowBackground（單色） -->
        <item name="android:windowBackground">@color/splash_background</item>
        <!-- enableEdgeToEdge() already does this for the activity window, but a ModalBottomSheet
             lives in its own dialog window, which reads these straight off the theme. Without
             them the sheet's window inherits colorPrimaryDark plus the system's automatic
             contrast scrim — which is why opening a sheet greyed out the status bar. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
    </style>

    <!-- Crop screen (wallpaper action). The library's confirm button lives in the
         ActionBar options menu, so this theme MUST have an ActionBar — inheriting the
         app's NoActionBar theme would leave the user with no way to confirm the crop. -->
    <style name="Theme.NexFlow.Crop" parent="Theme.AppCompat.DayNight" />

    <!-- Transparent host for MenuPickerActivity / ShortcutRunActivity: only the bottom sheet
         is ever visible, and a shortcut run with no menu shows nothing at all.
         DayNight parent, not Material.Light: these windows sit on top of the launcher, and a
         light-only parent hands the sheet's dialog window light system-bar defaults even in
         dark mode. -->
    <style name="Theme.NexFlow.Transparent" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
        <!-- Starting from a home-screen shortcut must not flash a blank preview window -->
        <item name="android:windowDisablePreview">true</item>
        <!-- Nothing of ours may tint the bars: whatever is behind (the launcher, another app)
             must show through untouched. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
    </style>
</resources>
