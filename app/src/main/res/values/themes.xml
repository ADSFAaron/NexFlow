<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- AppCompat.DayNight parent is required because MainActivity extends
         AppCompatActivity (for in-app per-app language switching). Compose still
         drives the real UI theme via NexFlowTheme; this only styles the window
         background / splash. -->
    <style name="Theme.NexFlow" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Android 12+ 的系統 splash 背景會 fallback 到 windowBackground（單色） -->
        <item name="android:windowBackground">@color/splash_background</item>
    </style>

    <!-- Crop screen (wallpaper action). The library's confirm button lives in the
         ActionBar options menu, so this theme MUST have an ActionBar — inheriting the
         app's NoActionBar theme would leave the user with no way to confirm the crop. -->
    <style name="Theme.NexFlow.Crop" parent="Theme.AppCompat.DayNight" />

    <!-- Transparent host for MenuPickerActivity: only the bottom sheet is visible -->
    <style name="Theme.NexFlow.Transparent" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>