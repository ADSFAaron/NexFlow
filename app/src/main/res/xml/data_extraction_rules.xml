<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup/transfer rules for Android 12+ (API 31+).
  The Room database (nexflow.db) can contain user secrets embedded in flows — e.g. auth
  headers/tokens on HTTP actions — so it is excluded from Google cloud backup. It is kept
  for local device-to-device transfer, which never leaves the user's devices. Flows can also
  be moved manually via the in-app JSON export/import.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="nexflow.db" />
        <exclude domain="database" path="nexflow.db-wal" />
        <exclude domain="database" path="nexflow.db-shm" />
        <!-- Holds the user-supplied Gemini API key. -->
        <exclude domain="sharedpref" path="nexflow_ai.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- Local transfer stays between the user's own devices; back everything up,
             except the Gemini API key which should be re-entered per device. -->
        <exclude domain="sharedpref" path="nexflow_ai.xml" />
    </device-transfer>
</data-extraction-rules>
