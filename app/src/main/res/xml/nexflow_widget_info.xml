<?xml version="1.0" encoding="utf-8"?>
<!-- The sizing and preview attributes are API 31+ and simply ignored on API 30, where the
     launcher falls back to minWidth/minHeight and the static preview image. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UnusedAttribute"
    android:description="@string/widget_overview_description"
    android:minWidth="245dp"
    android:minHeight="180dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="40dp"
    android:maxResizeWidth="624dp"
    android:maxResizeHeight="422dp"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable|configuration_optional"
    android:previewLayout="@layout/widget_preview_overview"
    android:configure="com.nexflow.widget.OverviewWidgetConfigureActivity" />
