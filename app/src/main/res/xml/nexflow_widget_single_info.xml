<?xml version="1.0" encoding="utf-8"?>
<!-- The sizing and preview attributes are API 31+ and simply ignored on API 30, where the
     launcher falls back to minWidth/minHeight and the static preview image. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UnusedAttribute"
    android:description="@string/widget_single_description"
    android:minWidth="56dp"
    android:minHeight="56dp"
    android:maxResizeWidth="306dp"
    android:maxResizeHeight="276dp"
    android:targetCellWidth="1"
    android:targetCellHeight="1"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable"
    android:previewLayout="@layout/widget_preview_single"
    android:configure="com.nexflow.widget.WidgetConfigureActivity" />
