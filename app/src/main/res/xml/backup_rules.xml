<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto-backup rules for API 30 (this app's minSdk). On API 31+ data_extraction_rules.xml is
  used instead. The Room database (nexflow.db) is excluded from cloud backup because flows can
  contain user secrets (e.g. HTTP auth tokens); everything else (prefs) is backed up.
-->
<full-backup-content>
    <exclude domain="database" path="nexflow.db" />
    <exclude domain="database" path="nexflow.db-wal" />
    <exclude domain="database" path="nexflow.db-shm" />
    <!-- Gemini API key — must stay off cloud backups on API 30 too (mirrors
         data_extraction_rules.xml; the Settings UI promises this exclusion). -->
    <exclude domain="sharedpref" path="nexflow_ai.xml" />
</full-backup-content>
