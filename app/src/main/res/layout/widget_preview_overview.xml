<?xml version="1.0" encoding="utf-8"?>
<!-- Preview layout for widget picker (API 31+). Uses View system, not Glance.
     Sets previewLayout so launcher renders real content instead of a monochrome app icon. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_widget_preview"
    android:padding="14dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="NexFlow"
            android:textColor="#E6E1E5"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5/5"
            android:textColor="#78DBD9"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Flow row 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="早安日常自動化"
            android:textColor="#CAC4D0"
            android:textSize="12sp"
            android:singleLine="true"
            android:ellipsize="end" />
        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_widget_play_btn"
            android:src="@android:drawable/ic_media_play"
            android:padding="7dp"
            android:tint="#1C1B1F" />
    </LinearLayout>

    <!-- Flow row 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="螢幕喚醒記錄"
            android:textColor="#CAC4D0"
            android:textSize="12sp"
            android:singleLine="true"
            android:ellipsize="end" />
        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_widget_play_btn"
            android:src="@android:drawable/ic_media_play"
            android:padding="7dp"
            android:tint="#1C1B1F" />
    </LinearLayout>

    <!-- Flow row 3 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="變數與控制流測試"
            android:textColor="#CAC4D0"
            android:textSize="12sp"
            android:singleLine="true"
            android:ellipsize="end" />
        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_widget_play_btn"
            android:src="@android:drawable/ic_media_play"
            android:padding="7dp"
            android:tint="#1C1B1F" />
    </LinearLayout>

</LinearLayout>
