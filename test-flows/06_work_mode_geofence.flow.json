      "id": "11111111-2222-4333-8444-555555555555",
      "type": "GEOFENCE",
      "config": {
        "lat": "25.033964",
        "lng": "121.564468",
        "radius_m": "150",
        "event": "ENTER"
      }
    }
  ],
  "trigger_logic": "ANY",
  "conditions": [],
  "actions": [
    {
      "id": "a0000000-0000-4000-8000-000000000000",
      "type": "NOTIFICATION",
      "config": {
        "title": "工作模式已啟動",
