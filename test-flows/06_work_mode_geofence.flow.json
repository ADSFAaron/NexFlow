      },
      "order": 0,
      "enabled": true
    },
    {
      "id": "a0000001-0000-4000-8000-000000000001",
      "type": "VOLUME_ADJUST",
      "config": {"stream": "RING", "level": "0"},
      "order": 1,
      "enabled": true
    },
    {
      "id": "a0000002-0000-4000-8000-000000000002",
      "type": "DND_TOGGLE",
      "config": {"state": "ON"},
      "order": 2,
      "enabled": true
    },
    {
      "id": "a0000003-0000-4000-8000-000000000003",
      "type": "HTTP_REQUEST",
      "config": {
        "url": "https://example.com/clock-in",
        "method": "POST",
        "body": "{\"event\":\"arrive\",\"place\":\"office\"}"
      },
      "order": 3,
      "enabled": true
    },
    {
      "id": "a0000004-0000-4000-8000-000000000004",
      "type": "TTS",
      "config": {"text": "已進入工作場所，已開啟工作模式。今日工作項目：晨會、回覆郵件、專案進度更新。"},
      "order": 4,
      "enabled": true
    }
  ],
  "variables": []
